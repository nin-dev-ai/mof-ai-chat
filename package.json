{
  "name": "weave-ai-chat",
  "version": "1.0.0",
  "description": "A framework-agnostic chat interface web component with i18n support",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node build-css.js && vite build && vite build --config ./config/vite.config.mts",
    "build:mobile": "node build-css.js && vite build --config ./config/vite.config.mts",
    "build:frontend": "node build-css.js && vite build --config ./config/vite.config.mts",
    "start": "webpack serve --config webpack.config.cjs --mode development --port 3000",
    "build:web": "BUILD_APP=1 webpack --config webpack.config.cjs --mode production && cp -R public/. dist/",
    "test": "jest",
    "build:css": "node build-css.js",
    "dev": "concurrently \"npm run start\" \"npm run build:css\"",
    "build:tailwind": "node build-tailwind.js",
    "watch:tailwind": "node watch-tailwind.js"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.13.6",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.0",
    "dompurify": "^3.2.6",
    "framer-motion": "^12.12.1",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.1.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.544.0",
    "marked": "^15.0.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.3",
    "react-markdown": "^10.1.0",
    "react-speech-recognition": "^4.0.1",
    "rehype-raw": "^7.0.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.2.1",
    "tinycolor2": "^1.6.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.3.0",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-speech-recognition": "^3.9.6",
    "@types/tinycolor2": "^1.4.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.14",
    "babel-loader": "^9.1.3",
    "chokidar": "^3.5.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.9.1",
    "jest": "^29.7.0",
    "postcss": "^8.4.24",
    "postcss-loader": "^8.0.0",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vite-plugin-static-copy": "^2.3.0",
    "vite-plugin-string": "^1.2.3",
    "vite-plugin-svgr": "^4.3.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
